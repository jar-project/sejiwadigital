# URL website production (tanpa slash di akhir)
NEXT_PUBLIC_SITE_URL=https://sejiwadigital.com

# Google Tag Manager container ID (GA4, Meta Pixel, TikTok Pixel, Google Ads dipasang via GTM)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Apps Script Web App (lihat apps-script/Code.gs). SERVER ONLY, jangan pakai prefix NEXT_PUBLIC_
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
APPS_SCRIPT_SECRET=ganti-dengan-string-acak-panjang
